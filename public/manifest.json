{
  "name": "__MSG_appName__",
  "version": "1.13.0",
  "description": "__MSG_appDescription__",
  "homepage_url": "https://app.lideguang.com/link-and-title-copy-pro/",
  "manifest_version": 3,
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus",
    "storage",
    "notifications",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.webp",
      "48": "icons/icon.webp",
      "128": "icons/icon.webp"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "default_locale": "en",
  "icons": {
    "16": "icons/icon.webp",
    "48": "icons/icon.webp",
    "128": "icons/icon.webp"
  },
  "options_page": "options.html",
  "commands": {
    "copy-template-0": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Copy selected text (or title) and URL"
    },
    "copy-template-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy as Markdown link"
    },
    "copy-template-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Smart copy with quotes for selected text"
    }
  }
}
