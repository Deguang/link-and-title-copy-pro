{
  "name": "link-and-title-copy-pro",
  "version": "1.12.0",
  "private": true,
  "description": "Link&amp;TitleCopyPro is a browser extension that allows you to copy both the title and URL link of a browser tab at the same time.",
  "main": "background.js",
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/sync-version.js",
    "prebuild": "npm run sync-version",
    "build": "vite build && BUILD_TARGET=background vite build && BUILD_TARGET=content vite build",
    "release": "npm run build && ./scripts/release.sh",
    "publish-release": "./scripts/publish.sh",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{js,mjs,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,mjs,jsx,ts,tsx}' --fix",
    "license:keygen": "node scripts/license/gen-keypair.mjs",
    "license:issue": "node scripts/license/issue-key.mjs",
    "test": "node --test src/utils/*.test.mjs",
    "test:watch": "node --test --watch src/utils/*.test.mjs",
    "ship": "./scripts/ship.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deguang/link-and-title-copy-pro.git"
  },
  "author": "LiDeguang",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/Deguang/link-and-title-copy-pro/issues"
  },
  "homepage": "https://app.lideguang.com/link-and-title-copy-pro/",
  "keywords": [],
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "globals": "^15.9.0",
    "tinify": "^1.8.2",
    "typescript-eslint": "^8.2.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-html-config": "^2.0.1"
  }
}
